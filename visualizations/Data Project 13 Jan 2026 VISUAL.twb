    <worksheet name='Deposit vs Credit Balance by Bank'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Arial'>Deposit vs Credit Balance by Bank</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cust_branch_dataset CLEANED' name='federated.05nwqyi0e9kmep149xu3g1gegca0' />
          </datasources>
          <datasource-dependencies datasource='federated.05nwqyi0e9kmep149xu3g1gegca0'>
            <column caption='Deposit Balance' datatype='real' name='[Calculation_3240166550990851]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [product_group] = &quot;Deposit&quot;&#10;THEN [balance]&#10;END' />
            </column>
            <column caption='Net Credit' datatype='real' name='[Calculation_3240166552662022]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Deposit Balance (copy)_3240166551441413]) + SUM([Deposit Balance (copy)_3240166551302148])' />
            </column>
            <column caption='Branch Coverage Tier' datatype='string' name='[Calculation_3240168412651540]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [branches_within_1km] = 0 THEN &quot;No Nearby Branch&quot;&#10;ELSEIF [branches_within_1km] &lt;= 2 THEN &quot;Low Coverage (1–2)&quot;&#10;ELSEIF [branches_within_1km] &lt;= 5 THEN &quot;Moderate Coverage (3–5)&quot;&#10;ELSEIF [branches_within_1km] &lt;= 10 THEN &quot;High Coverage (6–10)&quot;&#10;ELSE &quot;Very High Coverage (10+)&quot;&#10;END' />
            </column>
            <column caption='Loan Balance' datatype='real' name='[Deposit Balance (copy)_3240166551302148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [product_group] = &quot;Loan&quot;&#10;THEN [balance]&#10;END' />
            </column>
            <column caption='Credit Balance' datatype='real' name='[Deposit Balance (copy)_3240166551441413]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [product_group] = &quot;Credit&quot;&#10;THEN [balance]&#10;END' />
            </column>
            <column caption='Total Deposit per Client (LOD)' datatype='real' name='[Deposit Balance (copy)_3240166639501327]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [cust_id] : SUM(IF [product_group] = &quot;Deposit&quot;&#10;THEN [balance]&#10;END)&#10;}' />
            </column>
            <column caption='Credit Share %' datatype='real' name='[IBB Share % (copy)_3240169452269612]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3240166552662022]&#10;/&#10;SUM([Calculation_3240166550990851])' />
            </column>
            <column-instance column='[Deposit Balance (copy)_3240166639501327]' derivation='Avg' name='[avg:Deposit Balance (copy)_3240166639501327:qk]' pivot='key' type='quantitative' />
            <column caption='Balance' datatype='real' name='[balance]' role='measure' type='quantitative' />
            <column datatype='integer' name='[branches_within_1km]' role='measure' type='quantitative' />
            <column-instance column='[cust_id]' derivation='CountD' name='[ctd:cust_id:qk]' pivot='key' type='quantitative' />
            <column caption='Cust City' datatype='string' name='[cust_city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
