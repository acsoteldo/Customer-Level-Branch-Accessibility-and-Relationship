      <style />
      <size sizing-mode='automatic' />
      <datasources>
        <datasource caption='cust_branch_dataset CLEANED' name='federated.05nwqyi0e9kmep149xu3g1gegca0' />
      </datasources>
      <datasource-dependencies datasource='federated.05nwqyi0e9kmep149xu3g1gegca0'>
        <column caption='Branch Coverage Tier' datatype='string' name='[Calculation_3240168412651540]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [branches_within_1km] = 0 THEN &quot;No Nearby Branch&quot;&#10;ELSEIF [branches_within_1km] &lt;= 2 THEN &quot;Low Coverage (1–2)&quot;&#10;ELSEIF [branches_within_1km] &lt;= 5 THEN &quot;Moderate Coverage (3–5)&quot;&#10;ELSEIF [branches_within_1km] &lt;= 10 THEN &quot;High Coverage (6–10)&quot;&#10;ELSE &quot;Very High Coverage (10+)&quot;&#10;END' />
        </column>
        <column caption='Cust City' datatype='string' name='[cust_city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
        <column caption='Cust Neighbourhood' datatype='string' name='[cust_neighbourhood]' role='dimension' type='nominal' />
        <column-instance column='[Calculation_3240168412651540]' derivation='None' name='[none:Calculation_3240168412651540:nk]' pivot='key' type='nominal' />
        <column-instance column='[cust_city]' derivation='None' name='[none:cust_city:nk]' pivot='key' type='nominal' />
        <column-instance column='[cust_neighbourhood]' derivation='None' name='[none:cust_neighbourhood:nk]' pivot='key' type='nominal' />
        <column caption='Primary Bank Name' datatype='string' name='[primary_bank_name (group)]' role='dimension' type='nominal'>
          <calculation class='categorical-bin' column='[primary_bank_name]' new-bin='true'>
            <bin default-name='false' value='&quot;BMO&quot;'>
              <value>&quot;BMO&quot;</value>
              <value>&quot;BMO Bank Of Montreal&quot;</value>
            </bin>
            <bin default-name='false' value='&quot;NBC&quot;'>
              <value>&quot;National Bank&quot;</value>
            </bin>
            <bin default-name='false' value='&quot;TD&quot;'>
              <value>&quot;TD&quot;</value>
              <value>&quot;TD Canada Trust&quot;</value>
            </bin>
          </calculation>
        </column>
        <column datatype='string' name='[primary_bank_name]' role='dimension' type='nominal' />
      </datasource-dependencies>
