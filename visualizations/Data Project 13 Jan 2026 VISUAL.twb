    <worksheet name='Transaction behavior vs branch coverage'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#555555' fontname='Arial' fontsize='12'>Avg Daily Transactions</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#555555' fontname='Arial' fontsize='9'>High coverage drives more frequent txn</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cust_branch_dataset CLEANED' name='federated.05nwqyi0e9kmep149xu3g1gegca0' />
          </datasources>
          <datasource-dependencies datasource='federated.05nwqyi0e9kmep149xu3g1gegca0'>
            <column caption='% Primary Branch Outside Top 3' datatype='real' name='[Calculation_3240166632968202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG( IIF([primary_branch_in_top3] = FALSE, 1, 0) )' />
            </column>
            <column caption='Digital Adoption %' datatype='real' name='[Calculation_3240166633553931]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG( IIF([uses_mobile_banking], 1, 0) )' />
            </column>
            <column caption='Branch Coverage Tier' datatype='string' name='[Calculation_3240168412651540]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [branches_within_1km] = 0 THEN &quot;No Nearby Branch&quot;&#10;ELSEIF [branches_within_1km] &lt;= 2 THEN &quot;Low Coverage (1–2)&quot;&#10;ELSEIF [branches_within_1km] &lt;= 5 THEN &quot;Moderate Coverage (3–5)&quot;&#10;ELSEIF [branches_within_1km] &lt;= 10 THEN &quot;High Coverage (6–10)&quot;&#10;ELSE &quot;Very High Coverage (10+)&quot;&#10;END' />
            </column>
            <column caption='Primary Branch Address' datatype='string' name='[Calculation_3240170350313520]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [primary_branch_address] = &quot;Not available&quot;&#10;Then &quot;No address&quot;&#10;ELSE [primary_branch_address]&#10;END' />
            </column>
            <column-instance column='[avg_daily_txn_count]' derivation='Avg' name='[avg:avg_daily_txn_count:qk]' pivot='key' type='quantitative' />
            <column caption='Avg Daily Txn' datatype='real' name='[avg_daily_txn_count]' role='measure' type='ordinal' />
            <column datatype='integer' name='[branches_within_1km]' role='measure' type='quantitative' />
            <column-instance column='[cust_id]' derivation='CountD' name='[ctd:cust_id:qk]' pivot='key' type='quantitative' />
            <column caption='Cust City' datatype='string' name='[cust_city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Cust Id' datatype='integer' name='[cust_id]' role='dimension' type='ordinal' />
            <column caption='Cust Neighbourhood' datatype='string' name='[cust_neighbourhood]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3240168412651540]' derivation='None' name='[none:Calculation_3240168412651540:nk]' pivot='key' type='nominal' />
            <column-instance column='[cust_city]' derivation='None' name='[none:cust_city:nk]' pivot='key' type='nominal' />
            <column-instance column='[cust_neighbourhood]' derivation='None' name='[none:cust_neighbourhood:nk]' pivot='key' type='nominal' />
            <column-instance column='[primary_branch_lat]' derivation='None' name='[none:primary_branch_lat:ok]' pivot='key' type='ordinal' />
            <column-instance column='[primary_branch_lon]' derivation='None' name='[none:primary_branch_lon:ok]' pivot='key' type='ordinal' />
            <column caption='Primary Bank Name' datatype='string' name='[primary_bank_name (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[primary_bank_name]' new-bin='true'>
