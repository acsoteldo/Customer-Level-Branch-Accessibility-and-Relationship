            <column caption='Cust Id' datatype='integer' name='[cust_id]' role='dimension' type='ordinal' />
            <column caption='Product Group' datatype='string' name='[product_group]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3240169354469402]' derivation='User' name='[usr:Calculation_3240169354469402:ok]' pivot='key' type='ordinal' />
