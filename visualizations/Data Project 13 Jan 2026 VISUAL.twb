      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.05nwqyi0e9kmep149xu3g1gegca0].[sum:Calculation_3240166550990851:qk]&quot;' value='Deposit' />
          <alias key='&quot;[federated.05nwqyi0e9kmep149xu3g1gegca0].[usr:Calculation_3240166552662022:qk]&quot;' value='Credit' />
        </aliases>
      </column>
      <column caption='Donut' datatype='integer' name='[Calculation_3240166542970882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Deposit Balance' datatype='real' name='[Calculation_3240166550990851]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF [product_group] = &quot;Deposit&quot;&#10;THEN [balance]&#10;END' />
      </column>
      <column caption='Net Credit' datatype='real' name='[Calculation_3240166552662022]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Deposit Balance (copy)_3240166551441413]) + SUM([Deposit Balance (copy)_3240166551302148])' />
      </column>
      <column caption='Product Count' datatype='integer' name='[Calculation_3240166575120391]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10; IF [active_flag] = &quot;Y&quot; THEN 1 ELSE 0 END&#10;)' />
      </column>
      <column caption='Deposit Product Count' datatype='integer' name='[Calculation_3240166586638344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10; IF [active_flag] = &quot;Y&quot;&#10; AND [product_group] = &quot;Deposit&quot;&#10; THEN 1 ELSE 0 END&#10;)' />
      </column>
      <column caption='% Primary Branch Outside Top 3' datatype='real' name='[Calculation_3240166632968202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG( IIF([primary_branch_in_top3] = FALSE, 1, 0) )' />
      </column>
      <column caption='Digital Adoption %' datatype='real' name='[Calculation_3240166633553931]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG( IIF([uses_mobile_banking], 1, 0) )' />
      </column>
      <column caption='Product Tier' datatype='string' name='[Calculation_3240166637928462]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Product Count (copy)_3240166634983437] &gt;= 4 THEN &quot;4+&quot;&#10;ELSEIF [Product Count (copy)_3240166634983437] = 3 THEN &quot;3&quot;&#10;ELSEIF [Product Count (copy)_3240166634983437] = 2 THEN &quot;2&quot;&#10;ELSE &quot;1&quot;&#10;END' />
      </column>
      <column caption='Deposit Tier' datatype='string' name='[Calculation_3240166639681552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Deposit Balance (copy)_3240166639501327] &gt;= 250000 THEN &quot;$250K+&quot;&#10;ELSEIF [Deposit Balance (copy)_3240166639501327] &gt;= 50000 THEN &quot;$50K–$250K&quot;&#10;ELSE &quot;$0–$50K&quot;&#10;END' />
      </column>
      <column caption='Distance Bucket' datatype='string' name='[Calculation_3240166640197649]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [primary_branch_km] &lt; 1 THEN &quot;0–1 km&quot;&#10;ELSEIF [primary_branch_km] &lt; 3 THEN &quot;1–3 km&quot;&#10;ELSEIF [primary_branch_km] &lt; 5 THEN &quot;3–5 km&quot;&#10;ELSE &quot;5+ km&quot;&#10;END' />
      </column>
      <column caption='Tenure' datatype='string' name='[Calculation_3240166648426514]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF INT([tenure_days]/365) &gt; 0 &#10;THEN STR(INT([tenure_days]/365)) + &quot;yr &quot; + STR([tenure_days] - INT([tenure_days]/365)*365) + &quot;d&quot;&#10;ELSE STR([tenure_days] - INT([tenure_days]/365)*365) + &quot;d&quot;&#10;END' />
      </column>
      <column caption='Cust Local' datatype='string' name='[Calculation_3240166654111763]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [primary_branch_in_top3] = TRUE&#10;AND [primary_branch_km] &lt;= 3&#10;THEN &quot;Local User&quot;&#10;ELSE &quot;Non-Local User&quot;&#10;END' />
      </column>
      <column caption='Branch Coverage Tier' datatype='string' name='[Calculation_3240168412651540]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [branches_within_1km] = 0 THEN &quot;No Nearby Branch&quot;&#10;ELSEIF [branches_within_1km] &lt;= 2 THEN &quot;Low Coverage (1–2)&quot;&#10;ELSEIF [branches_within_1km] &lt;= 5 THEN &quot;Moderate Coverage (3–5)&quot;&#10;ELSEIF [branches_within_1km] &lt;= 10 THEN &quot;High Coverage (6–10)&quot;&#10;ELSE &quot;Very High Coverage (10+)&quot;&#10;END' />
      </column>
      <column caption='Clients per Branch Coverage' datatype='real' name='[Calculation_3240168422625301]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([cust_id]) / AVG([branches_within_1km])' />
      </column>
      <column caption='% Low Coverage Customers' datatype='real' name='[Calculation_3240168980660247]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;    IF [branches_within_1km] &lt;= 2 THEN 1 ELSE 0 END&#10;)' />
      </column>
      <column caption='Bottom 80% Clients Balance' datatype='real' name='[Calculation_3240169354059801]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : PERCENTILE(&#10;    { FIXED [cust_id] : SUM(IF [product_group] = &quot;Deposit&quot; THEN [balance] ELSE 0 END) }&#10;    , 0.80) }' />
      </column>
      <column caption='Top 20% Clients Balance' datatype='real' name='[Calculation_3240169354469402]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM(IF [Deposit Balance (copy)_3240166639501327] &gt;= [Calculation_3240169354059801] &#10;    AND [product_group] = &quot;Deposit&quot; &#10;    THEN [balance] ELSE 0 END)&#10;/&#10;SUM(IF [product_group] = &quot;Deposit&quot; THEN [balance] ELSE 0 END)' />
      </column>
      <column caption='NIDDA Balance' datatype='real' name='[Calculation_3240169355194396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [deposit_category] = &quot;NIDDA&quot; AND [product_group] = &quot;Deposit&quot; &#10;THEN [balance] &#10;ELSE 0 &#10;END' />
      </column>
      <column caption='IBB Balance' datatype='real' name='[Calculation_3240169355276317]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF [deposit_category] = &quot;IBB&quot; AND [product_group] = &quot;Deposit&quot; &#10;THEN [balance] &#10;ELSE 0 &#10;END' />
      </column>
      <column caption='IBB Share %' datatype='real' name='[Calculation_3240169355821087]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3240169355276317])&#10;/&#10;SUM([Calculation_3240166550990851])' />
      </column>
      <column caption='Products per Client (LOD)' datatype='integer' name='[Calculation_3240169362706465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [cust_id] : COUNTD([product_type]) }' />
      </column>
      <column caption='High Product Count Flag' datatype='integer' name='[Calculation_3240169362866210]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF { FIXED [cust_id] : COUNTD(IF [active_flag] = &quot;Y&quot; &#10;    THEN [product_type] END) } &gt;= 3&#10;THEN 1 ELSE 0&#10;END' />
      </column>
      <column caption='Penetration Rate' datatype='real' name='[Calculation_3240169362980899]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3240169362866210]) / COUNTD([cust_id])' />
      </column>
      <column caption='Top1 Distance' datatype='string' name='[Calculation_3240170335318061]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND([top1_km], 1)) + &quot;km, &quot; &#10;+ STR(ROUND([top1_minutes], 0)) + &quot;mins&quot;' />
