              <calculation class='tableau' formula='IF INT([tenure_days]/365) &gt; 0 &#10;THEN STR(INT([tenure_days]/365)) + &quot;yr &quot; + STR([tenure_days] - INT([tenure_days]/365)*365) + &quot;d&quot;&#10;ELSE STR([tenure_days] - INT([tenure_days]/365)*365) + &quot;d&quot;&#10;END' />
            </column>
            <column caption='Branch Coverage Tier' datatype='string' name='[Calculation_3240168412651540]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [branches_within_1km] = 0 THEN &quot;No Nearby Branch&quot;&#10;ELSEIF [branches_within_1km] &lt;= 2 THEN &quot;Low Coverage (1–2)&quot;&#10;ELSEIF [branches_within_1km] &lt;= 5 THEN &quot;Moderate Coverage (3–5)&quot;&#10;ELSEIF [branches_within_1km] &lt;= 10 THEN &quot;High Coverage (6–10)&quot;&#10;ELSE &quot;Very High Coverage (10+)&quot;&#10;END' />
            </column>
            <column caption='IBB Balance' datatype='real' name='[Calculation_3240169355276317]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [deposit_category] = &quot;IBB&quot; AND [product_group] = &quot;Deposit&quot; &#10;THEN [balance] &#10;ELSE 0 &#10;END' />
            </column>
            <column caption='Top1 Distance' datatype='string' name='[Calculation_3240170335318061]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(ROUND([top1_km], 1)) + &quot;km, &quot; &#10;+ STR(ROUND([top1_minutes], 0)) + &quot;mins&quot;' />
            </column>
            <column caption='Primary Branch Address' datatype='string' name='[Calculation_3240170350313520]' role='dimension' type='nominal'>
